    "2249:2904": [
      {
        "do": "if",
        "when": "script_exists:bescort",
        "then": [
          {
            "do": "run_script",
            "script": "bescort",
            "args": [
              "gondola",
              "south"
            ]
          }
        ],
        "else": [
          {
            "do": "await",
            "cmd": "go gondola",
            "timeout": 10,
            "on_timeout": "continue",
            "for": "There is no wooden gondola here\\.|Gondola,\\ Cab\\ North",
            "bind": {
              "boarded": 0
            }
          },
          {
            "do": "if",
            "when": "not:capture_match:boarded=Gondola,\\ Cab\\ North",
            "then": [
              {
                "do": "echo",
                "msg": "waiting for the gondola..."
              },
              {
                "do": "await",
                "timeout": 1800,
                "on_timeout": "fail",
                "for": "The gondola stops on the platform and the door silently swings open\\."
              },
              {
                "do": "move",
                "cmd": "go gondola"
              }
            ]
          },
          {
            "do": "move",
            "cmd": "south"
          },
          {
            "do": "await",
            "timeout": 1800,
            "on_timeout": "fail",
            "for": "With a soft bump, the gondola comes to a stop at its destination\\."
          },
          {
            "do": "move",
            "cmd": "out"
          }
        ]
      }
    ],
